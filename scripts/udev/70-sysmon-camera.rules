# Let the sysmon-camera group toggle USB video interfaces for the Camera button.
#
# sysmon-agent runs as a desktop user service (the Mic/Media/Lock buttons need
# the session), but Linux camera control writes each UVC interface's sysfs
# `authorized` file and /sys/bus/usb/drivers_probe, both root-only by default.
# This rule hands the per-interface files to the sysmon-camera group;
# scripts/tmpfiles/sysmon-camera.conf does the same for drivers_probe, which
# the agent checks to decide whether control is available at all.
#
# Install with:
#   sudo groupadd -r sysmon-camera && sudo usermod -aG sysmon-camera "$USER"
#   sudo install -m 0644 scripts/udev/70-sysmon-camera.rules /etc/udev/rules.d/
#   sudo install -m 0644 scripts/tmpfiles/sysmon-camera.conf /etc/tmpfiles.d/
#   sudo systemd-tmpfiles --create /etc/tmpfiles.d/sysmon-camera.conf
#   sudo udevadm trigger --subsystem-match=usb --action=change
# then log out and back in (or reboot) so the user manager picks up the group.
#
# ACTION includes "change" for the same reason as 99-powercap-rapl.rules:
# `udevadm trigger` defaults to it, and an add-only rule silently does nothing.
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="0e", ACTION=="add|change", \
  RUN+="/bin/sh -c 'chgrp sysmon-camera /sys%p/authorized && chmod 0664 /sys%p/authorized'"
